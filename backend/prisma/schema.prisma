generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}
  
datasource db {
  provider = "postgresql"
}

model User {
  id                      Int        @id @default(autoincrement())
  firstName               String     
  surname                 String
  email                   String     @unique
  cardEncrypted           String     @unique
  cardHash                String     @unique
  password                String
  bankAccount             BankAccount[]
  LoggingHistory          LoggingHistory[]
  TransactionsHistory     TransactionsHistory[]
}

model BankAccount {
  id              Int        @id @default(autoincrement())
  balance         Int   
  userId          Int       @unique
  bankAccountId   User      @relation(fields: [userId], references: [id])
}

model LoggingHistory {
  id                Int        @id @default(autoincrement())
  userId            Int        
  method            String
  urlPath           String
  statusCode        String
  time              DateTime
  userIdRelations   User      @relation(fields: [userId], references: [id])
}

model TransactionsHistory {
  id                Int        @id @default(autoincrement())
  senderId          Int
  receiverId        Int
  amount            Int
  currency          String
  status            Boolean
  userTransaction   User    @relation(fields: [senderId], references: [id])
}