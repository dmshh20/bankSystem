generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  moduleFormat = "cjs"
}
  
datasource db {
  provider = "postgresql"
}

model User {
  id                      Int        @id @default(autoincrement())
  firstName               String     
  surname                 String
  email                   String     @unique
  cardEncrypted           String     @unique
  cardHash                String     @unique
  password                String
  bankAccount             BankAccount[]
}

model BankAccount {
  id              Int        @id @default(autoincrement())
  balance         Int   
  userId          Int       @unique
  bankAccountId   User      @relation(fields: [userId], references: [id])
}
